POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_workforce
POSTGRES_USER=ai_workforce
POSTGRES_PASSWORD=ai_workforce
DATABASE_URL=postgresql+psycopg://ai_workforce:ai_workforce@postgres:5432/ai_workforce

JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-in-production-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_workforce_chunks

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123456
AWS_REGION=us-east-1
AWS_BUCKET=ai-workforce
AWS_ENDPOINT_URL=http://minio:9000

REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
